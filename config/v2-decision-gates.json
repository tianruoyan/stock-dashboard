  "maturity_states": ["clue", "observe", "await_confirmation", "decision_ready", "weakened", "ended"],
  "action_languages": ["积极关注", "等待确认", "不追", "风险释放", "降低关注"],
  "positive_decision_ready_requires": ["G0", "G1", "G2", "G3", "G4", "G5", "G6", "G7"],
  "theme_role_minimum": 2,
  "representative_quote_required_fields": ["stock_code", "name", "stock_change_pct", "stock_quote_as_of", "stock_quote_source", "role", "basis"],
  "default_validity": {
    "intraday_minutes": 30,
    "event_observation": "下一关键盘面检查点",
    "missing_validity_action": "不能进入决策就绪"
  },
  "guardrails": {
    "verified_equals_decision_ready": false,
    "decision_ready_equals_buy": false,
