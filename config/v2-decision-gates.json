  "gate_order": ["G0", "G1", "G2", "G3", "G4", "G5", "G6", "G7"],
  "gates": {
    "G0": {"label": "数据可用", "question": "来源、时间、字段和冲突是否足以支持本次判断"},
    "G1": {"label": "触发成立", "question": "是否发生了有操作意义的实质变化"},
    "G2": {"label": "对象明确", "question": "主题、单股、风格或事件对象是否明确"},
    "G3": {"label": "代表股确认", "question": "代表股代码、真实行情、角色和共振是否完整"},
    "G4": {"label": "原因可解释", "question": "事实、推断与未知是否分开，原因是否可核验"},
    "G5": {"label": "环境许可", "question": "全市场环境支持、部分支持、中性、抑制还是阻断"},
    "G6": {"label": "位置可交易", "question": "位置、拥挤、流动性和可买性是否清楚"},
    "G7": {"label": "条件与时窗", "question": "加强、失效和有效时间是否完整"}
  },
  "gate_states": ["pass", "partial", "pending", "suppress", "block", "fail", "not_applicable"],
  "business_paths": ["theme_opportunity", "single_stock_event", "cross_market_mapping", "risk_path"],
