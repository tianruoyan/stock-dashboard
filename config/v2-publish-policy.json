{
  "schema_version": 1,
  "name": "dashboard-generated-data",
  "version": "phase1-wp4-1",
  "include_globs": [
    "data/*.json",
    "data/**/*.json",
    "topics/*.md",
    "topics/*.html",
    "topics/**/*.md",
    "topics/**/*.html"
  ],
  "exclude_globs": [
    "data/**/*.tmp",
    "data/**/*.lock"
  ],
  "target_remote": "origin",
  "target_branch": "main",
  "max_push_attempts": 3
}
