{
  "schema_version": 1,
  "name": "dashboard-generated-data",
  "version": "phase1-wp4-2-private-inputs",
  "include_globs": [
    "data/*.json",
    "data/**/*.json",
    "topics/*.md",
    "topics/*.html",
    "topics/**/*.md",
    "topics/**/*.html"
  ],
  "exclude_globs": [
    "data/**/*.tmp",
    "data/**/*.lock",
    "data/v2/inputs/**",
    "data/v2/outcome-prices.json",
    "data/v2/input-import-manifest.json"
  ],
  "target_remote": "origin",
  "target_branch": "main",
  "max_push_attempts": 3
}
