<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.stock-dashboard.ths-watchlist</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/sweet_orange/stock-dashboard/scripts/import_ths_watchlist.py</string>
    <string>--mode</string>
    <string>ths</string>
  </array>

  <key>StartInterval</key>
  <integer>1800</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>WorkingDirectory</key>
  <string>/Users/sweet_orange/stock-dashboard</string>

  <key>StandardOutPath</key>
  <string>/Users/sweet_orange/stock-dashboard/logs/ths-watchlist.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/sweet_orange/stock-dashboard/logs/ths-watchlist.err.log</string>
</dict>
</plist>
