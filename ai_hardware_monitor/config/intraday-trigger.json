{
  "schema_version": 1,
  "version": "1.0.0",
  "enabled": true,
  "timezone": "Asia/Shanghai",
  "poll_interval_seconds": 180,
  "notification_cooldown_minutes": 30,
  "windows": [
    {"id": "morning", "label": "上午盘中", "start": "09:40", "end": "11:25"},
    {"id": "afternoon", "label": "午后盘中", "start": "13:05", "end": "14:50"}
  ],
  "conditions": {
    "minimum_score": 60,
    "minimum_coverage_ratio": 0.65,
    "maximum_sector_rank": 3,
    "minimum_relative_outperformance_pct": 1.0,
    "minimum_advance_ratio_pct": 70,
    "minimum_leading_core_count": 1,
    "minimum_leader_turnover_pace": 1.2
  },
  "notification": {
    "desktop_enabled": true,
    "title": "AI硬件盘中触发提醒",
    "sound": "default"
  },
  "guardrails": {
    "automatic_trading": false,
    "position_change": false,
    "candidate_is_buy_instruction": false,
    "missing_fact_inference": false
  }
}

